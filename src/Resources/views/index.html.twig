{% extends '@AropixelAdmin/List/datatable.html.twig' %}
{% import '@AropixelAdmin/Macro/actions.html.twig' as list %}

{% block header_title %}{% trans %}pages.title.description{% endtrans %}{% endblock %}
{% block header_breadcrumb %}
    <ul class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ url('_admin') }}">{% trans %}text.dashboard{% endtrans %}</a></li>
        <li class="breadcrumb-item active">{% trans %}pages.title{% endtrans %}</li>
    </ul>
{% endblock %}

{% block header_top_right %}
    {% if page_builder_enabled %}
        <button type="button" class="btn btn-small btn-primary ms-3"
                data-bs-toggle="popover"
                data-bs-html="true"
                data-bs-placement="bottom"
                data-bs-trigger="click"
                data-bs-custom-class="popover-large"
                data-bs-content="
                    <div class='p-0'>
                        <a href='{{ path('aropixel_default_page_new') }}' class='d-block text-decoration-none p-4 py-3'>
                            <div class='fw-bold text-darker-primary'>{% trans %}pages.create.default.title{% endtrans %}</div>
                            <div class='text-muted small'>{% trans %}pages.create.default.desc{% endtrans %}</div>
                        </a>
                        <hr class='m-0'>
                        <a href='{{ path('aropixel_builder_page') }}' class='d-block text-decoration-none p-4 py-3'>
                            <div class='fw-bold text-darker-primary'>{% trans %}pages.create.builder.title{% endtrans %}</div>
                            <div class='text-muted small'>{% trans %}pages.create.builder.desc{% endtrans %}</div>
                        </a>
                    </div>
                ">
            {{ ux_icon('lucide:plus', {class: 'me-2'}) }} {% trans %}pages.create.button{% endtrans %}
        </button>
    {% else %}
        <a href="{{ path('aropixel_default_page_new') }}" class="btn btn-small btn-primary ms-3">
            {{ ux_icon('lucide:plus', {class: 'me-2'}) }} {% trans %}pages.create.button{% endtrans %}
        </a>
    {% endif %}
{% endblock %}

{% block theme_stylesheets %}
    {{ parent() }}
    {% if page_builder_enabled %}
    <style>
        .popover-large {
            --bs-popover-max-width: 350px;
            --bs-popover-border-color: var(--aro-color-primary);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .popover-large .popover-body {
            padding: 0;
        }
        .popover-large a:hover {
            background-color: var(--aro-color-bg);
            border-radius: 0.25rem;
        }
    </style>
    {% endif %}
{% endblock %}

{% block theme_javascripts %}
    {{ parent() }}
    {% if page_builder_enabled %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl)
            })

            document.addEventListener('click', function (e) {
                popoverList.forEach(function (popover) {
                    var trigger = popover._element
                    var tip = popover.tip
                    if (!trigger.contains(e.target) && !(tip && tip.contains(e.target))) {
                        popover.hide()
                    }
                })
            })
        });
    </script>
    {% endif %}
{% endblock %}

{% block paneltitle %}{% trans %}page.text.list{% endtrans %}{% endblock %}

{% block paneldatatable %}

    <table class="table text-nowrap datatable">
        <thead>
            <tr>
                <th class="no-sort" style="width: 100px"></th>
                <th>{% trans %}page.list.header.title{% endtrans %}</th>
                <th>{% trans %}page.list.header.date{% endtrans %}</th>
                <th class="no-sort" style="width:100px">{% trans %}text.actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>

            {% for page in pages %}

                {% set edit_route = page.type == 'builder' ? 'aropixel_builder_page_edit' : 'aropixel_default_page_edit' %}

                <tr>
                    <td>
                        <a class="position-relative" href="{{ path(edit_route, {id: page.id}) }}">
                            <img class="img-rounded rounded-3" src="{{ null|aropixel_imagine_filter('admin_thumbnail') }}" height="60" />
                            <span class="state-icon img-state-icon state-icon--{{ page.status }}" title="{{ page.status == 'online' ? 'status.published'|trans : 'status.offline'|trans }}"></span>
                        </a>
                    </td>
                    <td>
                        <a class="d-flex align-items-center" href="{{ path(edit_route, {id: page.id}) }}">
                            {{ page.title }}
                        </a>
                    </td>
                    <td>{{ page.createdAt|date('d/m/Y') }}</td>
                    <td class="text-right">
                        {{ list.actions(
                            page,
                            path(edit_route, {id: page.id}),
                            page.isDeletable ? path('aropixel_page_delete', {id: page.id}) : null,
                            'pages.list.delete_warning'|trans,
                            null,
                            page.isDeletable ? csrf_token('delete__' ~ page.type ~ '_page' ~ page.id) : null,
                        ) }}
                    </td>
                </tr>

            {% endfor %}

        </tbody>
    </table>

{% endblock %}
